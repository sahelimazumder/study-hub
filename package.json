{
  "name": "ranchi-study-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "node scripts/run-tests.mjs",
    "ingest": "python scripts/ingest.py",
    "content": "python scripts/build_content.py",
    "preview": "vite preview --host 127.0.0.1",
    "build:public": "tsc -b && vite build --mode public && node scripts/audit-public.mjs",
    "preview:public": "vite preview --mode public --port 5174 --strictPort",
    "audit:public": "node scripts/audit-public.mjs",
    "test:public": "vitest run --mode public --exclude \"release/**\" tests/public.test.ts tests/features.test.ts tests/ai.test.ts",
    "start": "powershell.exe -NoLogo -NoProfile -File scripts/manage-local.ps1 -Action Start",
    "status": "powershell.exe -NoLogo -NoProfile -File scripts/manage-local.ps1 -Action Status",
    "stop": "powershell.exe -NoLogo -NoProfile -File scripts/manage-local.ps1 -Action Stop",
    "disable:autostart": "powershell.exe -NoLogo -NoProfile -File scripts/manage-local.ps1 -Action Disable",
    "test:server": "vitest run tests/localServer.test.ts --exclude \"release/**\""
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.2.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.5"
  }
}
